{
  "name": "phoneme-activity-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:browser": "npm run build && node scripts/run-browser-tests.mjs",
    "check": "npm run lint && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:setup": "prisma db push && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "next": "^16.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.2",
    "prisma": "^6.12.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true,
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
